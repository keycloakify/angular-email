{
  "name": "angular-email",
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "sh scripts/build.sh",
    "watch": "ng build angular-email --watch",
    "render:test": "keycloakify-angular-email build -p projects/showcase/emails -o dist/emails -e tailwindcss,@tailwindcss/postcss,postcss,postcss-calc,postcss-custom-properties,postcss-preset-env,postcss-logical",
    "release": "sh scripts/release.sh",
    "changelog": "conventional-changelog -t -p angular -i CHANGELOG.md -s -r 0",
    "_format": "prettier '**/*.{ts,html,json,md}'",
    "format": "pnpm _format --write",
    "lint": "ng lint --fix"
  },
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "@keycloakify/angular-email": "link:dist/angular-email",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@jsx-email/doiuse-email": "^1.0.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/pretty": "^2.0.3",
    "angular-eslint": "22.6.0",
    "cheerio": "^1.2.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "esbuild": "catalog:",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "juice": "^12.2.3",
    "ng-packagr": "^22.2.6",
    "npm-check-updates": "^23.1.1",
    "postcss": "^8.5.32",
    "postcss-calc": "^11.2.3",
    "postcss-custom-properties": "^15.0.4",
    "postcss-logical": "^9.0.2",
    "postcss-preset-env": "^11.6.2",
    "prettier": "^3.10.1",
    "pretty": "^2.0.0",
    "tailwindcss": "^4.3.5",
    "termost": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0"
