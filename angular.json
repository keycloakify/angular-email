{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-email": {
      "projectType": "library",
      "root": "projects/angular-email",
      "sourceRoot": "projects/angular-email/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/angular-email/tsconfig.lib.json",
            "outputPath": "dist/angular-email",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/angular-email/tailwindcss-preset-email",
                "output": "tailwindcss-preset-email",
                "ignore": ["css-processor/**"]
              }
            ],
            "allowedNonPeerDependencies": [
              "html-to-text",
              "cheerio",
              "@angular/build",
              "@angular/platform-server",
              "@angular/ssr",
              "@angular/router",
              "juice",
              "pretty",
              "termost"
            ]
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/angular-email/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/angular-email/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/angular-email/src/**/*.ts", "projects/angular-email/src/**/*.html"]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
